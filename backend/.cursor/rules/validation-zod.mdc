# Zod Validation Standards

## Validation Schema Template

```typescript
// src/validations/product.validation.ts
import { z } from "zod";

// Reusable schemas
const idSchema = z.string().regex(/^[0-9a-fA-F]{24}$/, "Invalid MongoDB ID");

// Query params validation
export const getProductsQuerySchema = z.object({
  query: z.object({
    page: z.coerce.number().int().positive().default(1),
    limit: z.coerce.number().int().positive().max(100).default(10),
    category: z.string().optional(),
    search: z.string().optional(),
    minPrice: z.coerce.number().positive().optional(),
    maxPrice: z.coerce.number().positive().optional(),
  }),
});

// Body validation
export const createProductSchema = z.object({
  body: z.object({
    name: z.string().min(2, "Name must be at least 2 characters").max(200),
    description: z.string().min(10).max(5000).optional(),
    category: z.string().regex(/^[0-9a-fA-F]{24}$/, "Invalid category ID"),
    price: z.number().positive("Price must be positive"),
    stock: z.number().int().min(0, "Stock cannot be negative"),
    variants: z
      .array(
        z.object({
          size: z.enum(["S", "M", "L", "XL", "ONE"]),
          color: z.string().min(1),
          stock: z.number().int().min(0),
          price: z.number().positive(),
          sku: z.string().min(1).max(50),
        }),
      )
      .optional(),
    images: z.array(z.string().url("Invalid image URL")).min(1),
    translations: z
      .object({
        en: z.object({
          name: z.string().min(2),
          description: z.string().min(10).optional(),
        }),
        es: z.object({
          name: z.string().min(2),
          description: z.string().min(10).optional(),
        }),
      })
      .optional(),
  }),
});

export const updateProductSchema = createProductSchema.partial();

// Params validation
export const productParamsSchema = z.object({
  params: z.object({
    id: idSchema,
  }),
});

// Export types
export type CreateProductInput = z.infer<typeof createProductSchema>["body"];
export type UpdateProductInput = z.infer<typeof updateProductSchema>["body"];
export type GetProductsQuery = z.infer<typeof getProductsQuerySchema>["query"];
```
