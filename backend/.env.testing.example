NODE_ENV=test
PORT=5000
MONGODB_URI=mongodb://localhost:27017/scaffold
JWT_SECRET=dev-secret-min-16-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://localhost:5173
ALLOW_DEV_ORG_FALLBACK=false
ALLOW_DEFAULT_ADMIN_SEED=true
PLATFORM_ADMIN_EMAIL=admin@innovexasolution.com
PLATFORM_ADMIN_PASSWORD=change-me

# Shared SSLCommerz sandbox merchant (see workspace SSLCOMMERZ_SHARED.md + .env.sslcommerz.example)
PAYMENT_APP_SLUG=scaffold
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=sslcommerz_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=sslcommerz_sandbox_store_password
API_PUBLIC_URL=http://localhost:5000
CLIENT_PUBLIC_URL=http://localhost:5173
SSLCOMMERZ_IPN_URL=http://localhost:5000/api/v1/payments/sslcommerz/ipn
SSLCOMMERZ_SUCCESS_URL=http://localhost:5173/#/billing?payment=success
SSLCOMMERZ_FAIL_URL=http://localhost:5173/#/billing?payment=fail
SSLCOMMERZ_CANCEL_URL=http://localhost:5173/#/billing?payment=cancel
