NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://user:pass@host/db?retryWrites=true&w=majority
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
REDIS_URL=redis://127.0.0.1:6379
# Category caches (categories:tree, categories:nav) — 1 hour
CATEGORY_CACHE_TTL=3600
NAV_CACHE_TTL=3600
# Product caches (products:featured, products:new, products:detail:*) — 30 minutes
PRODUCT_CACHE_TTL=1800

# Dev only — never enable in production
ALLOW_DEV_ORG_FALLBACK=false
DEFAULT_ORG_SLUG=
DEFAULT_ORG_ID=

# Seed scripts
ALLOW_DEFAULT_ADMIN_SEED=false
PLATFORM_ADMIN_EMAIL=admin@gblrc.com
PLATFORM_ADMIN_PASSWORD=Test@123456
