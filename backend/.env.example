NODE_ENV=production
# Local often uses 5000; production VPS uses 5002 behind nginx
PORT=5002

# MongoDB (auth + replica set rs0)
MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/gbl_rc_drone_db?authSource=admin&replicaSet=rs0

JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Comma-separated browser origins (storefront + admin)
CORS_ORIGIN=https://rcdrone.gblent.com,https://admin-rcdrone.gblent.com

REDIS_URL=redis://127.0.0.1:6379

# Category caches (categories:tree, categories:nav) — 1 hour
CATEGORY_CACHE_TTL=3600
NAV_CACHE_TTL=3600
# Product caches (products:featured, products:new, products:detail:*) — 30 minutes
PRODUCT_CACHE_TTL=1800

# Public API origin (used for absolute links / invoices / uploads)
API_PUBLIC_URL=https://rcdrone.gblent.com

# Dev only — never enable in production
ALLOW_DEV_ORG_FALLBACK=false
DEFAULT_ORG_SLUG=
DEFAULT_ORG_ID=

# Seed scripts
ALLOW_DEFAULT_ADMIN_SEED=false
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=ChangeMe@123456
