{
  "name": "hobbyrc-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "echo \"Runtime uses tsx (npm start). Optional typecheck: npx tsc -p tsconfig.json --noEmit\"",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed.ts",
    "migrate": "tsx scripts/migrate-schema.ts",
    "migrate:products": "tsx scripts/migrate-products.ts",
    "verify": "tsx scripts/verify.ts",
    "test:integration": "tsx scripts/integration-test.ts",
    "test:perf": "tsx scripts/perf-test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "multer": "^2.2.0",
    "socket.io": "^4.8.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.13.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
